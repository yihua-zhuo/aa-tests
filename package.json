{
  "name": "clay-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Claymorphism SaaS analytics dashboard built on Node.js 26, Hono and React",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173 node --watch --env-file-if-exists=.env src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env src/server.ts",
    "start:locked": "NODE_ENV=production node --permission --allow-fs-read='*' --allow-fs-write='./data' --allow-net --env-file-if-exists=.env src/server.ts",
    "test": "node --test test/",
    "test:web": "vitest run",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 test/",
    "lint": "biome check .",
    "lint:css": "stylelint \"web/src/**/*.css\"",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "check:runtime": "node scripts/check-runtime.mjs",
    "ci": "npm run check:runtime && npm run typecheck && npm run lint && npm run lint:css && npm test && npm run test:web && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.14",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.2",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^28.1.0",
    "stylelint": "^17.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
