# Copy to .env and adjust. `npm start` and Docker Compose both read this file.
# Never commit the real .env.

# ---------- Runtime ----------
PORT=3000
NODE_ENV=production
# SQLite file; its directory must be writable by the process.
DB_PATH=./data/pulse.db
# Optional: serve a prebuilt SPA from this directory (defaults to web/dist in production).
# STATIC_DIR=./web/dist
LOG_LEVEL=info
# IANA timezone used for date buckets and "today" in the UI.
WORKSPACE_TIMEZONE=Asia/Shanghai
# Grace period for load balancers to notice readiness during shutdown.
SHUTDOWN_DRAIN_MS=1000

# ---------- Attachments and avatars ----------
# Upload directory; defaults to an `uploads` folder next to DB_PATH.
# Mount it on persistent storage alongside the database.
# UPLOAD_DIR=./data/uploads
# HMAC key for 10-minute private download links. Set a long random value so
# links survive restarts; when empty a random key is generated per process.
# UPLOAD_SIGNING_SECRET=

# ---------- Local OCR ----------
# Sidecar URLs from scripts/ocr_sidecar.py. Leave empty to disable OCR; uploads
# still work and are marked as skipped.
# OCR_PADDLE_URL=http://127.0.0.1:8765
# OCR_DOCLING_URL=http://127.0.0.1:8766
# Shared secret sent as X-OCR-Token; must match the sidecar's OCR_TOKEN.
# OCR_TOKEN=
# PaddleOCR model set. Defaults to PP-OCRv6 medium; the sidecar falls back to
# PP-OCRv5 server when the v6 models are unavailable.
# OCR_PADDLE_DET_MODEL=PP-OCRv6_medium_det
# OCR_PADDLE_REC_MODEL=PP-OCRv6_medium_rec
# PDF pages with a usable text layer are read directly; scanned pages are
# rendered at this DPI before OCR.
# OCR_PDF_DPI=200
# PDF pages with a text layer are always read and don't count against the page
# caps below. Only scanned pages are counted as OCR pages.
# OCR_MAX_PDF_PAGES=100
# Hard limit on total pages inspected in one PDF; anything beyond is skipped.
# OCR_MAX_PDF_TOTAL_PAGES=1000
# OCR stops after this many seconds and returns the pages processed so far
# (the response text says how many pages were read).
# OCR_PDF_TIME_BUDGET_SECONDS=240
# Minimum 0-1 trust score for a PDF text layer. Low-trust pages (placeholder or
# corrupted glyphs) are rendered and OCR'd instead of trusting the text layer.
# OCR_PDF_TEXT_TRUST_MIN=0.6
# Cross-validate trusted text-layer pages by sampling a deterministic share and
# re-OCR-ing the rendered page. Native text is never replaced; mismatches become
# quality issues only. 0 disables sampling.
# OCR_PDF_TEXT_CROSSCHECK_RATE=0.1
# OCR_PDF_TEXT_CROSSCHECK_MAX_PAGES=2
# OCR_PDF_TEXT_CROSSCHECK_MIN_SIMILARITY=0.85
# How often the worker looks for queued attachments.
# OCR_INTERVAL_SECONDS=5
# Request timeout for one attachment (model warm-up and page conversion included).
# OCR_TIMEOUT_SECONDS=300
# Recovery cascade: a failed quality check triggers targeted retries (higher DPI,
# table structure, enhanced preprocessing) until the score passes or either cap
# is reached. Failed retries never overwrite the best extraction.
# OCR_CASCADE_MAX_STAGES=3
# OCR_CASCADE_BUDGET_SECONDS=180
# Recovery success probabilities adapt to recorded outcomes once a stage has
# this many attempts; below it the hard-coded prior is used.
# OCR_RECOVERY_YIELD_MIN_SAMPLES=5
# Low-confidence key fields are re-read region by region. Up to 4 regions per run;
# disagreement triggers a wider enhanced pass (1-3 passes per region).
# OCR_REGION_MAX_CANDIDATES=4
# OCR_REGION_PASSES=2
# Typed table cells (amount/date/quantity/percentage/number) are re-read one by
# one when unparseable or in a low-confidence table. Up to 4 cells per run;
# candidates are recorded as evidence and never replace the cell text.
# OCR_CELL_MAX_CANDIDATES=4
# OCR_CELL_PASSES=2
# Ink-gap miss detection: binarize each page, mask every box the recognizer
# claimed, and report the ink no box explains (independent of confidence). A
# table cell read as empty or as a placeholder keeps only its ruled borders
# masked, so ink written inside it still surfaces. Sidecar caps: analysis
# resolution, minimum ink pixels per gap (floored at 8), gaps per page
# (OCR_INK_MAX_GAPS=0 disables the detector; the other knobs cannot).
# OCR_INK_MAX_REGIONS bounds how many gaps the cascade re-reads per run;
# recovered text is appended as its own flagged block.
# OCR_INK_MAX_SIDE=900
# OCR_INK_MIN_PIXELS=45
# OCR_INK_MAX_GAPS=12
# OCR_INK_MAX_REGIONS=3
# Decode QR/1D barcodes from page pixels as independent evidence (OpenCV for QR,
# optional pyzbar for 1D); MRZ bands are parsed from recognized text with ICAO
# 9303 check digits. Set OCR_MACHINE_READABLE=0 to disable symbol decoding.
# OCR_MACHINE_READABLE=1
# OCR_MACHINE_READABLE_MAX_SYMBOLS=8
# Quality thresholds on a 0-1 score: below review -> needs human review, below
# fail -> marked failed. Low-confidence signal flags line confidences under this.
# OCR_QUALITY_REVIEW_THRESHOLD=0.7
# OCR_QUALITY_FAIL_THRESHOLD=0.45
# OCR_LOW_CONFIDENCE=0.75
# Preflight quality thresholds for shadow/glare/noise/skew; exceeded values
# force review and can trigger the enhanced recovery pass.
# OCR_MAX_GLARE=0.02
# OCR_MAX_SHADOW=0.35
# OCR_MAX_NOISE=0.09
# OCR_MAX_SKEW=3
# Enhanced mode generates at most this many photometric candidates (shadow
# correction, contrast, denoise, sharpen, binarize, red channel) and only
# adopts one that measurably beats the original image.
# OCR_PREPROCESS_MAX_CANDIDATES=4
# Optional page-boundary perspective/deskew before photometric preprocessing.
# Bounding boxes are mapped back to the original image coordinates.
# OCR_PREPROCESS_GEOMETRY=0
# Native PDF pages still OCR embedded raster regions (charts, screenshots,
# scanned inserts) larger than this area ratio; full-page images are skipped
# because their text is already in the native layer.
# OCR_HYBRID_IMAGE_MIN_RATIO=0.04
# OCR_HYBRID_IMAGE_MAX_REGIONS=2
# Multi-frame TIFF/GIF images are split into up to this many frames.
# OCR_MAX_IMAGE_FRAMES=20
# Sidecar-side page/time caps for optional converters. Camelot returns the
# tables it finished and marks the result truncated once a cap is hit.
# OCR_CAMELOT_MAX_PAGES=200
# OCR_CAMELOT_TIME_BUDGET_SECONDS=120
# OCR_DOCLING_MAX_PAGES=500
# OCR_MAX_OFFICE_PAGES=200
# Tracked corpus for the admin accuracy benchmark; relative paths resolve from
# the working directory. Run it from the Ops page or POST /api/ocr/lab/run.
# OCR_BENCH_DIR=benchmarks/ocr
# Release gates evaluated against the latest benchmark run. Claims with no
# data report null rather than passing by default.
# OCR_GATE_MAX_CER=0.05
# OCR_GATE_MIN_FULLY_CORRECT=0.8
# OCR_GATE_MAX_FAILED_RATE=0.1
# OCR_GATE_MAX_BUSINESS_LOSS=0.05
# OCR_GATE_MIN_TABLE_TEDS=0.9
# Calibration needs enough binned samples to mean anything.
# OCR_GATE_MAX_ECE=0.15
# OCR_GATE_ECE_MIN_SAMPLES=20
# A good overall average can hide one failing document type/language/difficulty.
# Groups with too few files (or too few field comparisons) do not participate,
# so a single-sample bucket cannot flip the gate.
# OCR_GATE_WORST_GROUP_MIN_FILES=3
# OCR_GATE_WORST_GROUP_MIN_FIELDS=3
# OCR_GATE_MAX_WORST_GROUP_CER=0.15
# OCR_GATE_MIN_WORST_GROUP_FIELD_ACCURACY=0.85
# Point estimates pass by luck on small corpora: gate the Wilson 95% lower
# bound, and require independent evidence for high-risk field categories.
# Amount/account default to 0.99, date/identifier to 0.95; a category with
# fewer than OCR_GATE_MIN_CATEGORY_SAMPLES comparisons fails instead of passing.
# OCR_GATE_MAX_SYMBOL_CER=0.01
# OCR_GATE_MIN_FIELD_ACCURACY_LOWER=0.9
# OCR_GATE_MIN_FULLY_CORRECT_LOWER=0.7
# OCR_GATE_MIN_AMOUNT_ACCURACY=0.99
# OCR_GATE_MIN_ACCOUNT_ACCURACY=0.99
# OCR_GATE_MIN_DATE_ACCURACY=0.95
# OCR_GATE_MIN_IDENTIFIER_ACCURACY=0.95
# OCR_GATE_MIN_CATEGORY_SAMPLES=30
# Localized field matching (review #41): a value found under a different label or
# on a different page is an error, so the gate reads the strong hit rate.
# OCR_GATE_MIN_FIELD_STRONG_ACCURACY=0.9
# Evidence sizing (review #67): every rate check reports the observations it had
# and the observations its threshold would need at the measured rate (Wilson 95%
# bound). A check that "passes" on fewer samples than that is reported as 证据不足
# by this aggregate check instead of certifying a release. Set to 1 to accept thin
# evidence (e.g. a smoke corpus) and drop the check.
# OCR_GATE_ALLOW_THIN_EVIDENCE=0
# TEDS on two tables says little; require this many scored tables.
# OCR_GATE_MIN_TABLE_STRUCTURE_SAMPLES=5
# The native-first PDF path must be represented in the release corpus.
# OCR_GATE_REQUIRE_PDF=1
# OCR_GATE_MIN_PDF_FILES=1
# Corpus roles (review #45): template families are hashed so every variant of one
# document lands in the same bucket. The release gate is judged on the blind split
# only; thresholds are fitted on the calibration split. Unlabeled corpora fall back
# to judging everything and say so in the gate note.
# OCR_BENCH_SPLIT_SALT=v1
# OCR_BENCH_DEV_SHARE=0.6
# OCR_BENCH_CALIBRATION_SHARE=0.2
# OCR_GATE_MIN_BLIND_FILES=3

# ---------- Passed-document random audit (review #38) ----------
# Sampling order for the unbiased audit of automatically `pass` documents:
# sha256(period|attachmentId|salt). Change the salt to reshuffle the same period.
# OCR_AUDIT_SALT=v1

# ---------- Revision quality control (review #69) ----------
# Human field revisions are annotations, and annotators make mistakes too. The
# second-opinion queue is ordered by sha256(revisionId|salt) so a rerun asks about
# the same revisions; change the salt to reshuffle.
# OCR_REVISION_QC_SALT=v1
# How much a revision only one person vouched for is allowed to move a fitted
# threshold: 0.4 means it counts as 40% of a doubly confirmed label. Disputed
# labels (someone dissented, nobody arbitrated) are dropped from the fit entirely.
# OCR_ANNOTATION_SINGLE_WEIGHT=0.4

# ---------- OCR model registry ----------
# Automatic promotion/rollback of registered models. When a full experiment is
# available, promotion additionally requires a paired McNemar test on per-file
# CER (p must not exceed OCR_REGISTRY_SIGNIFICANCE).
# OCR_REGISTRY_AUTO=1
# OCR_REGISTRY_MIN_SAMPLES=20
# OCR_REGISTRY_PROMOTE_MARGIN=0.01
# OCR_REGISTRY_ROLLBACK_MARGIN=0.02
# OCR_REGISTRY_SIGNIFICANCE=0.05

# ---------- Demo data ----------
# 1 = seeded demo accounts and analytics (default). Set 0 for real deployments.
DEMO_MODE=0

# ---------- Bootstrap admin (required when DEMO_MODE=0) ----------
# Password must be at least 8 chars and not a known weak/common password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=管理员

# ---------- TLS and proxies ----------
# Set to 1 only when a trusted reverse proxy terminates TLS.
TRUST_PROXY=1
COOKIE_SECURE=1
# Local HTTP only (e.g. docker compose without a TLS proxy): set both lines below.
# COOKIE_SECURE=0
# ALLOW_INSECURE_COOKIES=1
# Comma-separated browser origins allowed to call the API / open WebSockets.
ALLOWED_ORIGINS=https://pulse.example.com
# Optional Host header allowlist (comma-separated).
# ALLOWED_HOSTS=pulse.example.com

# ---------- Sessions and limits ----------
SESSION_IDLE_HOURS=12
RATE_LIMIT_MAX=240
LOGIN_RATE_LIMIT_MAX=30
IMPORT_RATE_LIMIT_MAX=10
MAX_SSE_CLIENTS=200
MAX_SSE_PER_IP=10
MAX_SSE_HANDSHAKES=30
# Per-token request budget for personal access tokens (fixed 1-minute window).
TOKEN_RATE_LIMIT_MAX=120
# Requests slower than this are logged as slow.
SLOW_REQUEST_MS=500

# ---------- Webhook delivery ----------
# How often pending deliveries are flushed and the per-request timeout.
WEBHOOK_INTERVAL_SECONDS=10
WEBHOOK_TIMEOUT_SECONDS=10

# ---------- Email notifications ----------
# Leave SMTP_HOST empty to keep email delivery disabled (in-app notifications
# still work). SMTP_FROM is required when SMTP_HOST is set.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=1
# SMTP_FROM=notifications@example.com
# SMTP_USER=
# SMTP_PASS=
# SMTP_HELO=localhost
# AUTH PLAIN over plaintext is rejected unless this is explicitly enabled.
# SMTP_ALLOW_INSECURE_AUTH=0
# How often the outbox worker flushes queued mail.
MAIL_INTERVAL_SECONDS=30

# ---------- Web Push and PWA ----------
# Browser push is enabled by default. VAPID keys are generated on first start and
# persisted in the database; set both variables below to use fixed keys instead.
# PUSH_ENABLED=0
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID subject sent to push services (mailto: or https: URL).
# PUSH_CONTACT=mailto:admin@example.com
# How often the push worker flushes pending notifications.
PUSH_INTERVAL_SECONDS=15

# ---------- Observability ----------
# Bearer token required by /metrics when set.
# METRICS_TOKEN=replace-with-a-long-random-token
# Serve /api/doc and /api/openapi.json in production.
API_DOCS=0

# ---------- Backups and retention ----------
# Defaults to <dirname of DB_PATH>/backups.
# BACKUP_DIR=./data/backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_HOURS=24
BACKUP_STARTUP_DELAY_SECONDS=60
# Soft-deleted projects are purged after this many days.
TRASH_RETENTION_DAYS=30
# OCR transcripts, structured documents and field revisions are purged after
# this many days. 0 (default) keeps them indefinitely.
# OCR_RETENTION_DAYS=0
