# Copy to .env and adjust. `npm start` and Docker Compose both read this file.
# Never commit the real .env.

# ---------- Runtime ----------
PORT=3000
NODE_ENV=production
# SQLite file; its directory must be writable by the process.
DB_PATH=./data/pulse.db
# Optional: serve a prebuilt SPA from this directory (defaults to web/dist in production).
# STATIC_DIR=./web/dist
LOG_LEVEL=info
# IANA timezone used for date buckets and "today" in the UI.
WORKSPACE_TIMEZONE=Asia/Shanghai
# Grace period for load balancers to notice readiness during shutdown.
SHUTDOWN_DRAIN_MS=1000

# ---------- Attachments and avatars ----------
# Upload directory; defaults to an `uploads` folder next to DB_PATH.
# Mount it on persistent storage alongside the database.
# UPLOAD_DIR=./data/uploads
# HMAC key for 10-minute private download links. Set a long random value so
# links survive restarts; when empty a random key is generated per process.
# UPLOAD_SIGNING_SECRET=

# ---------- Demo data ----------
# 1 = seeded demo accounts and analytics (default). Set 0 for real deployments.
DEMO_MODE=0

# ---------- Bootstrap admin (required when DEMO_MODE=0) ----------
# Password must be at least 8 chars and not a known weak/common password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=管理员

# ---------- TLS and proxies ----------
# Set to 1 only when a trusted reverse proxy terminates TLS.
TRUST_PROXY=1
COOKIE_SECURE=1
# Local HTTP only (e.g. docker compose without a TLS proxy): set both lines below.
# COOKIE_SECURE=0
# ALLOW_INSECURE_COOKIES=1
# Comma-separated browser origins allowed to call the API / open WebSockets.
ALLOWED_ORIGINS=https://pulse.example.com
# Optional Host header allowlist (comma-separated).
# ALLOWED_HOSTS=pulse.example.com

# ---------- Sessions and limits ----------
SESSION_IDLE_HOURS=12
RATE_LIMIT_MAX=240
LOGIN_RATE_LIMIT_MAX=30
IMPORT_RATE_LIMIT_MAX=10
MAX_SSE_CLIENTS=200
MAX_SSE_PER_IP=10
MAX_SSE_HANDSHAKES=30
# Per-token request budget for personal access tokens (fixed 1-minute window).
TOKEN_RATE_LIMIT_MAX=120
# Requests slower than this are logged as slow.
SLOW_REQUEST_MS=500

# ---------- Webhook delivery ----------
# How often pending deliveries are flushed and the per-request timeout.
WEBHOOK_INTERVAL_SECONDS=10
WEBHOOK_TIMEOUT_SECONDS=10

# ---------- Email notifications ----------
# Leave SMTP_HOST empty to keep email delivery disabled (in-app notifications
# still work). SMTP_FROM is required when SMTP_HOST is set.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=1
# SMTP_FROM=notifications@example.com
# SMTP_USER=
# SMTP_PASS=
# SMTP_HELO=localhost
# AUTH PLAIN over plaintext is rejected unless this is explicitly enabled.
# SMTP_ALLOW_INSECURE_AUTH=0
# How often the outbox worker flushes queued mail.
MAIL_INTERVAL_SECONDS=30

# ---------- Web Push and PWA ----------
# Browser push is enabled by default. VAPID keys are generated on first start and
# persisted in the database; set both variables below to use fixed keys instead.
# PUSH_ENABLED=0
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID subject sent to push services (mailto: or https: URL).
# PUSH_CONTACT=mailto:admin@example.com
# How often the push worker flushes pending notifications.
PUSH_INTERVAL_SECONDS=15

# ---------- Observability ----------
# Bearer token required by /metrics when set.
# METRICS_TOKEN=replace-with-a-long-random-token
# Serve /api/doc and /api/openapi.json in production.
API_DOCS=0

# ---------- Backups and retention ----------
# Defaults to <dirname of DB_PATH>/backups.
# BACKUP_DIR=./data/backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_HOURS=24
BACKUP_STARTUP_DELAY_SECONDS=60
# Soft-deleted projects are purged after this many days.
TRASH_RETENTION_DAYS=30
